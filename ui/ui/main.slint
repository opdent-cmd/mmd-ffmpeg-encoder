import { Button, ComboBox, LineEdit, Palette } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: root.chinese ? "MMD FFmpeg 编码器配置" : "MMD FFmpeg Encoder Settings";
    width: 520px;
    height: 640px;
    // Windows system fonts without CJK coverage (e.g. the default Slint
    // sans-serif) render Chinese text as boxes (口口口). Microsoft YaHei
    // ships with Windows 10/11 and covers both Latin and CJK glyphs.
    default-font-family: "Microsoft YaHei UI";

    // Force a light color scheme. Without this, Slint follows the Windows
    // dark mode and renders white control text on the light window
    // background, making the controls unreadable.
    init => {
        Palette.color-scheme= ColorScheme.light;
    }
    background: Palette.background;

    // Bridge properties between the UI and the Rust side.
    in-out property <int> vendor-index: 0;
    in-out property <int> codec-index: 0;
    in-out property <int> rate-index: 0;
    in-out property <string> kbps-input: "8000";
    in-out property <int> container-index: 1;
    in-out property <int> alpha-index: 0;
    in-out property <string> status-text: root.chinese ? "就绪" : "Ready";
    in-out property <string> config-path: "";
    in-out property <string> config-short: "";
    in-out property <bool> chinese: true;
    in-out property <string> hardware-status: root.chinese ? "正在探测 FFmpeg 和 GPU..." : "Detecting FFmpeg and GPUs...";

    callback save-requested;
    callback refresh-hardware;

    VerticalLayout {
        padding: 24px;
        spacing: 8px;

        Text {
            text: root.chinese ? "MMD FFmpeg 视频编码器" : "MMD FFmpeg Encoder";
            font-size: 18px;
            font-weight: 700;
            color: Palette.foreground;
        }

        Rectangle { height: 1px; background: #e3e3e3; }

        GridLayout {
            spacing: 12px;

            Row {
                Text {
                    text: root.chinese ? "硬件加速" : "Hardware";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.vendor-index;
                    enabled: root.alpha-index == 0;
                    model: root.chinese ? ["兼容优先（CPU）", "NVIDIA (NVENC)", "Intel (QSV)", "AMD (AMF)", "仅 CPU"] : ["Compatibility first (CPU)", "NVIDIA (NVENC)", "Intel (QSV)", "AMD (AMF)", "CPU only"];
                }
            }
            Row {
                Text {
                    text: root.chinese ? "编码格式" : "Codec";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.codec-index;
                    enabled: root.alpha-index == 0;
                    model: ["H.264", "HEVC", "AV1"];
                }
            }
            Row {
                Text {
                    text: root.chinese ? "码率模式" : "Rate control";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.rate-index;
                    enabled: root.alpha-index == 0;
                    model: root.chinese ? ["自动（质量优先，CRF）", "动态码率 (VBR)", "恒定码率 (CBR)"] : ["Auto (quality / CRF)", "Variable bitrate (VBR)", "Constant bitrate (CBR)"];
                }
            }
            Row {
                Text {
                    text: root.chinese ? "码率 (kbps)" : "Bitrate (kbps)";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                LineEdit {
                    text <=> root.kbps-input;
                    input-type: InputType.number;
                    // Manual bitrate is used by both VBR and CBR.
                    enabled: root.alpha-index == 0 && root.rate-index != 0;
                }
            }
            Row {
                Text {
                    text: root.chinese ? "输出文件" : "Container";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.container-index;
                    enabled: root.alpha-index == 0;
                    model: root.chinese ? ["MP4（推荐）", "MKV", "AVI（旧）"] : ["MP4 (recommended)", "MKV", "AVI (legacy)"];
                }
            }
            Row {
                Text {
                    text: root.chinese ? "透明输出" : "Alpha output";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.alpha-index;
                    model: root.chinese ? ["关闭", "WebM (VP9 透明)", "MOV (ProRes 4444 透明)", "MKV (FFV1 无损透明)"] : ["Off", "WebM (VP9 alpha)", "MOV (ProRes 4444 alpha)", "MKV (FFV1 lossless alpha)"];
                }
            }
        }

        Text {
            text: root.chinese ? "透明输出使用 CPU 编码。" : "Alpha output uses CPU encoding.";
            font-size: 11px;
            color: #8a6d1a;
            visible: root.alpha-index != 0;
            wrap: word-wrap;
        }

        Rectangle {
            background: #f4f7fb;
            border-width: 1px;
            border-color: #d9e2ef;
            border-radius: 4px;
            min-height: 94px;
            VerticalLayout {
                padding: 10px;
                spacing: 5px;
                HorizontalLayout {
                    Text {
                        text: root.chinese ? "硬件能力探测" : "Hardware detection";
                        font-weight: 700;
                        color: Palette.foreground;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.chinese ? "重新探测" : "Refresh";
                        clicked => { refresh-hardware(); }
                    }
                }
                Text {
                    text: root.hardware-status;
                    font-size: 11px;
                    color: #425466;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }

        // Status + save button on the same line, tight to the form.
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.status-text;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: #1a7f37;
                font-size: 13px;
            }
            Button {
                text: root.chinese ? "保存配置" : "Save";
                clicked => { save-requested(); }
            }
        }

        Rectangle { height: 1px; background: #e3e3e3; }

        Text {
            text: (root.chinese ? "配置文件：" : "Config: ") + root.config-short;
            font-size: 11px;
            color: #737373;
            Tooltip {
                Text { text: root.config-path; }
            }
        }
    }
}
