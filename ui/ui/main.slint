import { Button, ComboBox, LineEdit, Palette } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MMD FFmpeg 编码器配置";
    width: 520px;
    height: 640px;
    // Windows system fonts without CJK coverage (e.g. the default Slint
    // sans-serif) render Chinese text as boxes (口口口). Microsoft YaHei
    // ships with Windows 10/11 and covers both Latin and CJK glyphs.
    default-font-family: "Microsoft YaHei UI";

    // Force a light color scheme. Without this, Slint follows the Windows
    // dark mode and renders white control text on the light window
    // background, making the controls unreadable.
    init => {
        Palette.color-scheme= ColorScheme.light;
    }
    background: Palette.background;

    // Bridge properties between the UI and the Rust side.
    in-out property <int> vendor-index: 0;
    in-out property <int> codec-index: 0;
    in-out property <int> rate-index: 0;
    in-out property <string> kbps-input: "8000";
    in-out property <int> container-index: 1;
    in-out property <int> alpha-index: 0;
    in-out property <string> status-text: "就绪";
    in-out property <string> config-path: "";
    in-out property <string> config-short: "";
    in-out property <string> hardware-status: "正在探测 FFmpeg 和 GPU...";

    callback save-requested;
    callback refresh-hardware;

    VerticalLayout {
        padding: 24px;
        spacing: 8px;

        // Header
        Text {
            text: "MMD FFmpeg 视频编码器";
            font-size: 18px;
            font-weight: 700;
            color: Palette.foreground;
        }
        Text {
            text: "选好硬件和码率，保存后下次 MMD 渲染自动生效";
            font-size: 12px;
            color: #595959;
        }

        Rectangle { height: 1px; background: #e3e3e3; }

        // Form: fixed right-aligned label column, controls share one
        // vertical center axis and fill the remaining width.
        GridLayout {
            spacing: 12px;

            Row {
                Text {
                    text: "硬件加速";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.vendor-index;
                    enabled: root.alpha-index == 0;
                    model: ["兼容优先（CPU，推荐）", "NVIDIA (NVENC)", "Intel (QSV)", "AMD (AMF)", "不使用（CPU）"];
                }
            }
            Row {
                Text {
                    text: "编码格式";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.codec-index;
                    enabled: root.alpha-index == 0;
                    model: ["H.264", "HEVC", "AV1"];
                }
            }
            Row {
                Text {
                    text: "码率模式";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.rate-index;
                    enabled: root.alpha-index == 0;
                    model: ["自动（质量优先，CRF）", "动态码率 (VBR)", "恒定码率 (CBR)"];
                }
            }
            Row {
                Text {
                    text: "码率 (kbps)";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                LineEdit {
                    text <=> root.kbps-input;
                    input-type: InputType.number;
                    // Manual bitrate is used by both VBR and CBR.
                    enabled: root.alpha-index == 0 && root.rate-index != 0;
                }
            }
            Row {
                Text {
                    text: "输出文件";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.container-index;
                    enabled: root.alpha-index == 0;
                    model: ["MP4（推荐，自动清理 AVI）", "MKV", "AVI（旧）"];
                }
            }
            Row {
                Text {
                    text: "透明输出";
                    min-width: 96px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                ComboBox {
                    current-index <=> root.alpha-index;
                    model: ["关闭", "WebM (VP9 透明)", "MOV (ProRes 4444 透明)", "MKV (FFV1 无损透明)"];
                }
            }
        }

        Text {
            text: "透明输出由 CPU 编码（VP9/ProRes/FFV1），无需选择硬件；请确认 MMD 输出本身包含 Alpha 通道。";
            font-size: 11px;
            color: #8a6d1a;
            visible: root.alpha-index != 0;
            wrap: word-wrap;
        }

        Rectangle {
            background: #f4f7fb;
            border-width: 1px;
            border-color: #d9e2ef;
            border-radius: 4px;
            min-height: 94px;
            VerticalLayout {
                padding: 10px;
                spacing: 5px;
                HorizontalLayout {
                    Text {
                        text: "硬件能力探测";
                        font-weight: 700;
                        color: Palette.foreground;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "重新探测";
                        clicked => { refresh-hardware(); }
                    }
                }
                Text {
                    text: root.hardware-status;
                    font-size: 11px;
                    color: #425466;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
            }
        }

        // Status + save button on the same line, tight to the form.
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.status-text;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: #1a7f37;
                font-size: 13px;
            }
            Button {
                text: "保存配置";
                clicked => { save-requested(); }
            }
        }

        Rectangle { height: 1px; background: #e3e3e3; }

        // Footer: short path (full path in tooltip) + gentle hint text.
        VerticalLayout {
            spacing: 3px;
            Text {
                text: "配置文件：" + root.config-short;
                font-size: 11px;
                color: #737373;
                Tooltip {
                    Text { text: root.config-path; }
                }
            }
            Text {
                text: "提示：选 MP4/MKV/透明格式时，渲染完成会自动合并音轨并清理 .avi，只保留一个文件。";
                font-size: 11px;
                color: #737373;
            }
        }
    }
}
